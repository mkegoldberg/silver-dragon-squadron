# Copy to .env for local dev. Set the same value in Netlify > Site settings > Environment variables.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Only needed to run scripts/migrate-images.ts (never needed by the site or
# Netlify). Find all three values in the Cloudinary console under
# Settings > API Keys. NEVER commit the real value.
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
